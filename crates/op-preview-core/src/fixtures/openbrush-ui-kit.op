{
  "version": "1.1",
  "formatVersion": "1.1",
  "variables": {
    "brush-accent": {
      "type": "color",
      "value": "#0071E3"
    },
    "brush-surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "brush-canvas": {
      "type": "color",
      "value": "#F5F5F7"
    },
    "brush-ink": {
      "type": "color",
      "value": "#1D1D1F"
    },
    "brush-muted": {
      "type": "color",
      "value": "#6E6E73"
    },
    "brush-border": {
      "type": "color",
      "value": "#D2D2D7"
    },
    "brush-type-control": {
      "type": "number",
      "value": 500
    },
    "brush-type-body": {
      "type": "number",
      "value": 400
    },
    "brush-type-title": {
      "type": "number",
      "value": 600
    },
    "brush-space-2": {
      "type": "number",
      "value": 8
    },
    "brush-space-6": {
      "type": "number",
      "value": 24
    }
  },
  "children": [],
  "pages": [
    {
      "id": "0",
      "name": "Screen",
      "children": [
        {
          "type": "frame",
          "id": "screen",
          "width": 400,
          "height": 300,
          "children": [
            {
              "type": "ref",
              "id": "button",
              "ref": "brush-button-primary",
              "x": 20,
              "y": 20
            },
            {
              "type": "ref",
              "id": "disabled",
              "ref": "brush-button-primary",
              "x": 20,
              "y": 100,
              "descendants": {
                "brush-button-primary": {
                  "state": {
                    "hovered": {
                      "type": "bool",
                      "default": false
                    },
                    "pressed": {
                      "type": "bool",
                      "default": false
                    },
                    "focused": {
                      "type": "bool",
                      "default": false
                    },
                    "disabled": {
                      "type": "bool",
                      "default": true
                    }
                  }
                }
              }
            },
            {
              "type": "ref",
              "id": "independent",
              "ref": "brush-button-primary",
              "x": 20,
              "y": 180
            }
          ]
        }
      ]
    },
    {
      "id": "kit",
      "name": "UI Kit",
      "children": [
        {
          "type": "frame",
          "id": "brush-button-primary",
          "name": "Button / Primary",
          "reusable": true,
          "width": 190,
          "height": 50,
          "layout": "horizontal",
          "padding": [
            0,
            16
          ],
          "alignItems": "center",
          "justifyContent": "center",
          "cornerRadius": 25,
          "fill": [
            {
              "type": "solid",
              "color": "$brush-accent"
            }
          ],
          "stroke": {
            "fill": [
              {
                "type": "solid",
                "color": "#0071E3"
              }
            ],
            "thickness": 2
          },
          "state": {
            "hovered": {
              "type": "bool",
              "default": false
            },
            "pressed": {
              "type": "bool",
              "default": false
            },
            "focused": {
              "type": "bool",
              "default": false
            },
            "disabled": {
              "type": "bool",
              "default": false
            }
          },
          "enabled": "!$self.disabled",
          "semantics": {
            "role": "button",
            "label": "Открыть редактор",
            "disabled": "$self.disabled"
          },
          "bindings": {
            "opacity": "$self.disabled ? 0.35 : $self.pressed ? 0.78 : $self.focused ? 0.86 : $self.hovered ? 0.94 : 1",
            "stroke": "$self.focused ? $vars['brush-ink'] : $vars['brush-accent']"
          },
          "events": {
            "onHoverEnter": [
              {
                "set": {
                  "$self.hovered": "true"
                }
              }
            ],
            "onHoverLeave": [
              {
                "set": {
                  "$self.hovered": "false"
                }
              }
            ],
            "onPressStart": [
              {
                "set": {
                  "$self.pressed": "true"
                }
              }
            ],
            "onPressEnd": [
              {
                "set": {
                  "$self.pressed": "false"
                }
              }
            ],
            "onPressCancel": [
              {
                "set": {
                  "$self.pressed": "false"
                }
              }
            ],
            "onFocus": [
              {
                "set": {
                  "$self.focused": "true"
                }
              }
            ],
            "onBlur": [
              {
                "set": {
                  "$self.focused": "false"
                }
              }
            ]
          },
          "transition": {
            "durationMs": 150,
            "easing": "ease_out",
            "properties": [
              "opacity",
              "stroke"
            ]
          },
          "children": [
            {
              "type": "text",
              "id": "brush-button-primary-label",
              "name": "Открыть редактор",
              "width": "fill_container",
              "height": "fit_content",
              "content": "Открыть редактор",
              "fontFamily": "Inter",
              "fontSize": 15,
              "lineHeight": 1.3,
              "fill": [
                {
                  "type": "solid",
                  "color": "$brush-surface"
                }
              ],
              "textAlign": "center",
              "fontWeight": "$brush-type-control",
              "textGrowth": "auto"
            }
          ],
          "x": 64,
          "y": 228
        }
      ]
    }
  ]
}
